# .dockerignore

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.db

# Backend
backend/__pycache__/
backend/venv/
backend/*.pyc
backend/.pytest_cache
backend/omop.db
backend/data/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# Environment
.env
.env.local


# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
